{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrashVault",
  "version": "1.0.0",
  "identifier": "com.crashvault.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrashVault",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#121418"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/crashvault-process"],
    "shortDescription": "Local native crash reporting for C/C++",
    "longDescription": "CrashVault captures fatal C/C++ crashes, symbolizes them, groups recurring failures, and presents diagnostics in a local developer desktop UI.",
    "category": "Development"
  }
}
