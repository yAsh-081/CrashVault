{
  "name": "crashvault-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare:sidecar": "bash scripts/copy-processor-sidecar.sh",
    "prepare:icons": "python3 scripts/generate_icons.py",
    "tauri": "tauri",
    "tauri:dev": "npm run prepare:icons && npm run prepare:sidecar && tauri dev",
    "tauri:build": "npm run prepare:icons && npm run prepare:sidecar && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
